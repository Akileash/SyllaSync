# Copy to .env (or local.env). Replace every placeholder with your own values.
# python main.py --check   reports missing names only and never prints these values.
# python main.py --all --dry-run   previews the pipeline and does not write anywhere.

CANVAS_URL=https://your-university.instructure.com
CANVAS_TOKEN=your_canvas_api_token
# Optional — if unset, Sylla Sync uses deterministic syllabus parsers only
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.6-flash
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
GOOGLE_SHEET_ID=your_google_sheet_id

# Comma-separated course codes to sync (leave blank to include all active Canvas courses)
# ALLOWED_COURSES=COURSE 101,COURSE 202,COURSE 401,COURSE 301,COURSE 302,COURSE 501

# Google Calendar ID for --calendar / --all (your Gmail, or a dedicated calendar ID; not an iCal URL)
GOOGLE_CALENDAR_ID=your_email@gmail.com

# Academic term year override (defaults to current calendar year)
# TERM_YEAR=2026

# Past-due Canvas lookback window in days (default 21)
# CANVAS_PAST_DUE_DAYS=21

# Local timezone for Calendar timed events and Discord "due today" windows
# LOCAL_TIMEZONE=America/Edmonton

# EXCEL_FILE_PATH=assignments.xlsx

# Pull Canvas grades into Masterlist columns K-M (default on). Set to 0 to leave those columns alone.
# SYNC_GRADES=1

# Canvas dues in a year before TERM_YEAR: warn (default, leave as-is),
# override (warn plus a due_overrides.json pin hint), or shift
# (coerce onto the term year when no pin exists).
# STALE_YEAR_POLICY=warn

# Optional OCR for scanned syllabus PDFs (default off). Needs Tesseract,
# pdf2image, and pytesseract. Missing tools are skipped; scanned PDFs
# without a text layer are not sent to Gemini.
# SYLLABUS_OCR=0

# Sheet layout (defaults match the current Masterlist template).
# For a simple header-plus-rows sheet, set SHEET_DATA_START_ROW=2
# and put headers in row 1. Required columns: A Task_ID, B Status,
# C Due date, D Due date, E Due time, F Course, G Type, H Title;
# K-M grades. I-J are left untouched. Missing tabs are not created.
# SHEET_TAB_NAME=Masterlist
# SHEET_DATA_START_ROW=11
# SHEET_META_TAB_NAME=SyllaSync_Meta
