CANVAS_URL=https://your-university.instructure.com
CANVAS_TOKEN=your_canvas_api_token
# Optional — if unset, Sylla Sync uses deterministic syllabus parsers only
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
GOOGLE_SHEET_ID=your_google_sheet_id

# Comma-separated course codes to sync (leave blank to include all active Canvas courses)
# ALLOWED_COURSES=MATH 201,MATH 209,MAT E 201,ECE 202,ECE 210,ENGG 299

# Google Calendar ID for --calendar (your Gmail, or a dedicated calendar ID)
# GOOGLE_CALENDAR_ID=your_email@gmail.com

# Academic term year override (defaults to current calendar year)
# TERM_YEAR=2026

# Past-due Canvas lookback window in days (default 21)
# CANVAS_PAST_DUE_DAYS=21

# Local timezone for Calendar timed events and Discord "due today" windows
# LOCAL_TIMEZONE=America/Edmonton

# EXCEL_FILE_PATH=assignments.xlsx
